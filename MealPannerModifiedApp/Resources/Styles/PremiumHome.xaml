<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Reusable typography (Apple-like hierarchy; respects FontScaleManager) -->
    <Style x:Key="PremiumEyebrowLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="CharacterSpacing" Value="0.8" />
    </Style>

    <Style x:Key="PremiumHeroTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeadline}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1.12" />
    </Style>

    <Style x:Key="PremiumSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLead}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>

    <Style x:Key="PremiumSectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="PremiumBodySecondary" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Glass-style surface: layered fill reads cleanly in light + dark themes -->
    <Style x:Key="PremiumGlassPanel" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Stroke" Value="{DynamicResource PanelBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#33000000" Offset="0,10" Radius="28" Opacity="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Elevated content card (full-opacity surface) -->
    <Style x:Key="PremiumElevatedCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Stroke" Value="{DynamicResource PanelBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceCard}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#28000000" Offset="0,16" Radius="36" Opacity="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PremiumCtaLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyProminent}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

</ResourceDictionary>
