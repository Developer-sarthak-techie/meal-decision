<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Base sizes at Standard scale; FontScaleManager.Apply updates these at runtime. -->
    <x:Double x:Key="FontSizeMicro">12</x:Double>
    <x:Double x:Key="FontSizeCaption">13</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeBodyProminent">15</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeLead">18</x:Double>
    <x:Double x:Key="FontSizeListTitle">20</x:Double>
    <x:Double x:Key="FontSizePageTitle">22</x:Double>
    <x:Double x:Key="FontSizeSection">24</x:Double>
    <x:Double x:Key="FontSizeScreenHeader">26</x:Double>
    <x:Double x:Key="FontSizeHero">28</x:Double>
    <x:Double x:Key="FontSizeHeadline">32</x:Double>
    <x:Double x:Key="FontSizeSubHeadline">24</x:Double>
</ResourceDictionary>
