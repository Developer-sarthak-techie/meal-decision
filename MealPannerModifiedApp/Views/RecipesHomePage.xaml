<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealPannerModifiedApp.Views.RecipesHomePage"
             Title="Recipes">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Recipe collections"
                   FontSize="{DynamicResource FontSizeScreenHeader}"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}" />
            <Label Text="Choose a meal type — 1000+ India-inspired recipes with clear steps and photos."
                   TextColor="{DynamicResource TextSecondary}"
                   LineBreakMode="WordWrap" />

            <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                <Button Text="🥪 Snacks"
                        Clicked="OnSnacksClicked"
                        BackgroundColor="{DynamicResource AccentBright}"
                        TextColor="{DynamicResource TextPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="54" />
                <Button Text="🍛 Lunch"
                        Clicked="OnLunchClicked"
                        BackgroundColor="{DynamicResource AccentSoft}"
                        TextColor="{DynamicResource TextPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="54" />
                <Button Text="🌅 Breakfast"
                        Clicked="OnBreakfastClicked"
                        BackgroundColor="{DynamicResource AccentSoft}"
                        TextColor="{DynamicResource TextPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="54" />
                <Button Text="🌙 Dinner"
                        Clicked="OnDinnerClicked"
                        BackgroundColor="{DynamicResource AccentSoft}"
                        TextColor="{DynamicResource TextPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="54" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
