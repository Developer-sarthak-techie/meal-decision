<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MealPannerModifiedApp.Models"
             x:Class="MealPannerModifiedApp.Views.HomeRemediesPage"
             Title="Home remedies">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Trusted-style self-care"
                   FontSize="{DynamicResource FontSizeSection}"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}" />
            <Label x:Name="CatalogHint"
                   FontSize="{DynamicResource FontSizeCaption}"
                   TextColor="{DynamicResource TextSecondary}"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <SearchBar x:Name="RemedySearch"
                       Placeholder="Try: fever, nausea, sore throat, bloating…"
                       TextChanged="OnSearchTextChanged"
                       SearchButtonPressed="OnSearchPressed"
                       BackgroundColor="{DynamicResource SurfaceCard}"
                       TextColor="{DynamicResource TextPrimary}"
                       PlaceholderColor="{DynamicResource TextSecondary}"
                       CancelButtonColor="{DynamicResource AccentBright}" />
            <HorizontalStackLayout Spacing="12">
                <Button Text="MedlinePlus"
                        Clicked="OnOpenMedlinePlus"
                        BackgroundColor="{DynamicResource AccentSoft}"
                        TextColor="{DynamicResource TextPrimary}"
                        FontSize="{DynamicResource FontSizeMicro}"
                        Padding="10,6" />
                <Button Text="WHO"
                        Clicked="OnOpenWho"
                        BackgroundColor="{DynamicResource AccentSoft}"
                        TextColor="{DynamicResource TextPrimary}"
                        FontSize="{DynamicResource FontSizeMicro}"
                        Padding="10,6" />
                <Button Text="NHS"
                        Clicked="OnOpenNhs"
                        BackgroundColor="{DynamicResource AccentSoft}"
                        TextColor="{DynamicResource TextPrimary}"
                        FontSize="{DynamicResource FontSizeMicro}"
                        Padding="10,6" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView x:Name="RemedyCollection"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnRemedySelected"
                        Margin="0,8,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:HomeRemedy">
                    <Border StrokeShape="RoundRectangle 14"
                            Stroke="{DynamicResource PanelBorder}"
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource SurfaceCard}"
                            Padding="14"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   LineBreakMode="WordWrap" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="›"
                                   FontSize="{DynamicResource FontSizeLead}"
                                   TextColor="{DynamicResource AccentBright}"
                                   VerticalOptions="Start" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{Binding Category}"
                                   FontSize="{DynamicResource FontSizeMicro}"
                                   TextColor="{DynamicResource TextSecondary}" />
                            <Label Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding SourceAlignmentNote}"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextSecondary}"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
