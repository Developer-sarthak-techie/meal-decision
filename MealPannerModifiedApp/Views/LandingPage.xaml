<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealPannerModifiedApp.Views.LandingPage"
             Title="Home">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Top bar: theme -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="{DynamicResource AccentSoft}"
                Padding="16,12"
                Margin="0,0,0,8">
            <VerticalStackLayout Spacing="12">
                <Label Text="Meal Planner"
                       FontSize="{DynamicResource FontSizePageTitle}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       VerticalOptions="Center" />
                <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Theme"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Picker x:Name="ThemePicker"
                                Title="Pick"
                                WidthRequest="150"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource SurfaceCard}"
                                SelectedIndexChanged="OnThemeChanged" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Text size"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Picker x:Name="FontSizePicker"
                                Title="Size"
                                WidthRequest="140"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource SurfaceCard}"
                                SelectedIndexChanged="OnFontSizeChanged" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">
                <Label Text="Welcome back, chef!"
                       FontSize="{DynamicResource FontSizeHero}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Plan something delicious today."
                       FontSize="{DynamicResource FontSizeSubtitle}"
                       TextColor="{DynamicResource TextSecondary}"
                       HorizontalTextAlignment="Center" />

                <Border StrokeShape="RoundRectangle 28"
                        Stroke="{DynamicResource AccentBright}"
                        StrokeThickness="3"
                        BackgroundColor="{DynamicResource SurfaceCard}"
                        Padding="24"
                        Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="16">
                        <Image x:Name="ChefImage"
                               Source="chef"
                               HeightRequest="220"
                               WidthRequest="220"
                               HorizontalOptions="Center"
                               Aspect="AspectFit"
                               SemanticProperties.Description="Animated chef illustration" />
                        <Label Text="Open the menu ☰ for Recipes, Home remedies, Dashboard, and Settings."
                               FontSize="{DynamicResource FontSizeBody}"
                               TextColor="{DynamicResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
