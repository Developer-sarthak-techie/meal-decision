<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Primary">#22D3EE</Color>
    <Color x:Key="PrimaryDark">#060A13</Color>
    <Color x:Key="Secondary">#67E8F9</Color>
    <Color x:Key="Surface">#0F172A</Color>
    <Color x:Key="CardSurface">#112038</Color>
    <Color x:Key="Background">#060A13</Color>
    <Color x:Key="TextPrimary">#F8FAFC</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="PanelBorder">#2A3A5B</Color>
    <Color x:Key="AccentSoft">#1E3751</Color>
    <Color x:Key="GradientStart">#22D3EE</Color>
    <Color x:Key="GradientEnd">#3B82F6</Color>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardSurface}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="BorderColor" Value="{DynamicResource PanelBorder}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="#04111D" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</ResourceDictionary>
