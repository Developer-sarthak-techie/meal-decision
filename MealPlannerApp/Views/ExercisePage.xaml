<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MealPlannerApp.Views.ExercisePage"
             Title="Exercise">
    <Grid RowDefinitions="Auto,*" Padding="20">
        <Label Text="Exercise Module" Style="{StaticResource PageTitle}" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Exercises}">
            <CollectionView.EmptyView>
                <Label Text="{Binding StatusText}" TextColor="{DynamicResource TextSecondary}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding TargetMuscle, StringFormat='Target: {0}'}" />
                            <Label Text="{Binding DurationMinutes, StringFormat='Duration: {0} minutes'}" />
                            <Label Text="{Binding StepsSummary}" TextColor="{DynamicResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
